PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change_me_to_a_long_random_secret"
DEMO_MODE=true

# AI providers (server-side only — never expose to the browser)
NUGEN_API_KEY=""
NUGEN_ENDPOINT="https://api.nugen.ai/v1/chat/completions"
Deepseek=""

# Optional live-data keys (Open-Meteo / USGS / Overpass need no key)
WEATHER_API_KEY=""
AIR_QUALITY_API_KEY=""
OPEN_METEO_BASE_URL="https://api.open-meteo.com"
USGS_EARTHQUAKE_API_URL="https://earthquake.usgs.gov/fdsnws/event/1/query"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# Official bulletin links (human-issued sources, linked not scraped)
SACHET_BASE_URL="https://sachet.ndma.gov.in"
INCOIS_BASE_URL="https://tsunami.incois.gov.in"

# Language service providers (optional — system degrades gracefully to
# English-original-retained fallback when unset; see services/language/)
INDICTRANS_BASE_URL=""
BHASHINI_API_KEY=""
BHASHINI_BASE_URL=""
STT_PROVIDER=""
