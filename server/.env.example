PORT=5000
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"
JWT_SECRET="change_me_to_a_long_random_secret"
DEMO_MODE=true

# ── Alert pipeline: demo vs production ──────────────────────────
# Production MUST be false. The backend enforces this (not just the UI):
# official-alert APIs reject demo records when false, even if present in DB.
ENABLE_DEMO_ALERTS=false

# ── Official alert sources ──────────────────────────────────────
# SACHET (NDMA CAP RSS) — public, no key required. Polled with ETag caching.
SACHET_ENABLED=true
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_POLL_MINUTES=10

# IMD official warnings — credentialed API. WITHOUT key the integration reports
# CONFIGURATION_REQUIRED and yields zero warnings (never synthesised).
# See the IMD API portal docs issued with your credentials for endpoint details.
IMD_ENABLED=true
IMD_API_BASE_URL=""
IMD_API_KEY=""

# CWC flood warnings — credited ONLY from the real CWC source. Disabled by
# default; without CWC_API_KEY the status is CONFIGURATION_REQUIRED.
CWC_ENABLED=false
CWC_API_KEY=""

# INCOIS ocean/tsunami advisories — same fail-closed rule as CWC.
INCOIS_ENABLED=false
INCOIS_API_KEY=""

# ── Browser push notifications (Web Push / VAPID, optional) ─────
# Without these keys push stays disabled and the app functions normally
# (subscriptions are still stored; delivery resumes once configured).
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@jeevangrid.in"

# AI providers (server-side only — never expose to the browser)
NUGEN_API_KEY=""
NUGEN_ENDPOINT="https://api.nugen.ai/v1/chat/completions"
# Healthcare-domain model for Climate → Health Intelligence. The service tries
# this first, then nugen-healthcare-india, then the configured disaster model.
NUGEN_HEALTH_MODEL=nugen-healthcare-india
Deepseek=""

# Optional live-data keys (Open-Meteo / USGS / Overpass need no key)
WEATHER_API_KEY=""
AIR_QUALITY_API_KEY=""
OPEN_METEO_BASE_URL="https://api.open-meteo.com"
USGS_EARTHQUAKE_API_URL="https://earthquake.usgs.gov/fdsnws/event/1/query"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# Official bulletin links (human-issued sources, linked not scraped)
SACHET_BASE_URL="https://sachet.ndma.gov.in"
INCOIS_BASE_URL="https://tsunami.incois.gov.in"

# Language service providers (optional — system degrades gracefully to
# English-original-retained fallback when unset; see services/language/)
INDICTRANS_BASE_URL=""
BHASHINI_API_KEY=""
BHASHINI_BASE_URL=""
STT_PROVIDER=""
