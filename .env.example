# JeevanGrid - Environment Configuration
# Copy this file to server/.env and fill in the values below.
# The platform reads only from server/.env; do NOT create .env.local.

# ======================
# Core / Server
# ======================
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NODE_ENV=development

# ======================
# Authentication / RBAC
# ======================
# Secret used to sign JWT tokens. Change to a strong random string for production.
JWT_SECRET=jeevangrid-dev-secret-must-change-for-prod

# ======================
# WorldPop (Population Demographics)
# ======================
# OPTIONAL. If omitted, the platform uses a built-in gridded estimate for India.
# Get a key at https://worldpop.org/ (free for research; rate limits apply).
# Without a key, the platform falls back to a static estimate -- acceptable for demo.
WORLDPOP_API_KEY=

# ======================
# OpenRouteService (Routing / Evacuation Routes)
# ======================
# OPTIONAL backend-only key. Never commit to client.
# Required for ORS avoid-polygon routing; fallback is honest "routing unavailable".
# Without a key, evacuation routes return "unavailable -- use local knowledge".
ORS_API_KEY=

# ======================
# Cloudinary (Photo Uploads)
# ======================
# Required for citizen photo submission in Emergency Report.
# Sign up at https://cloudinary.com/ -- free tier sufficient for demo.
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=1234567890abcdef
CLOUDINARY_API_SECRET=your-cloudinary-secret-here

# ======================
# Copernicus Data Space Ecosystem
# ======================
# OPTIONAL. Credentials for catalogue metadata search.
# Manual GeoJSON import works without these.
# Get credentials at https://identity.dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ======================
# SACHET RSS Feed (Official India Warnings)
# ======================
# Auto-ingested; no credentials needed.
# The platform applies a 90-minute freshness gate (fail-closed).
# If the RSS feed is stale (last updated Nov 8 2026), official alerts page
# will show 0 LIVE warnings -- this is expected behaviour.
SACHET_RSS_URL=https://rss.india.gov.in/relief/rss_india.xml

# ======================
# Feature Flags (optional)
# ======================
# Set to false to disable a feature without removing code.
# These are checked on the backend; frontend panels may also respect them.
IMPACT_FEATURE_ENABLED=true
COMMUNITY_FEATURE_ENABLED=true
PLAYBOOK_FEATURE_ENABLED=true
ROUTING_FEATURE_ENABLED=true
ACKNOWLEDGEMENT_FEATURE_ENABLED=true
SATELLITE_FEATURE_ENABLED=true

# ======================
# Demo / Simulation
# ======================
# If set to true, the /api/alerts/demo-scenarios endpoint returns the 6 demo
# alerts pre-loaded in the database (isDemoData:true). Useful for training
# the acknowledgement workflow without touching production data.
ENABLE_DEMO_SCENARIOS=true

# ======================
# Nugen AI (Disaster Guidance)
# ======================
# NUGEN_API_KEY is a backend-only credential -- never commit to client,
# Vite variables, Git, or expose in any frontend response.
# The key "nugen-84dd22f5c66731ae" is a placeholder; replace with your
# actual Nugen API key before running the server.
# Nugen API: POST https://api.nugen.in/api/v3/inference/chat/completions
# Bearer auth: Authorization: Bearer <NUGEN_API_KEY>
# Model: Qwen/Qwen2.5-0.5B-Instruct (or any aligned model via the API)
# The platform uses timeout, error handling, and falls back to the local
# aligned disaster engine when Nugen is unavailable.
NUGEN_API_KEY=nugen-84dd22f5c66731ae
NUGEN_ENDPOINT=https://api.nugen.in/api/v3/inference/chat/completions

# Cloudflare Workers AI (IndicTrans2 English -> Indic)
# CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN are backend-only credentials.
# Never commit these to client, Vite variables, or Git.
CLOUDFLARE_ACCOUNT_ID=placeholder-account-id
CLOUDFLARE_API_TOKEN=placeholder-api-token

# ======================
# Demo / Simulation
# ======================
# If set to true, the /api/alerts/demo-scenarios endpoint returns the 6 demo
# alerts pre-loaded in the database (isDemoData:true). Useful for training
# the acknowledgement workflow without touching production data.
ENABLE_DEMO_SCENARIOS=true